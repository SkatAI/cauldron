# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# OpenRouter API key (required)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use for moderation (required)
OPENROUTER_MODEL=google/gemini-2.5-flash

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cauldron

# App settings
APP_ENV=development
LOG_LEVEL=info

# Optional shared secret expected from BFF via X-BFF-Secret header.
# Set this in production to block direct public calls.
BFF_SHARED_SECRET=

# Telegram monitoring
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase (for monitoring)
NEXT_PUBLIC_SUPABASE_URL=https://aqfesmowrjjtdlmbipvq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_

# ADK (for monitoring)
NEXT_PUBLIC_ADK_BASE_URL=https://sociosim-adk-e4hi9.ondigitalocean.app
